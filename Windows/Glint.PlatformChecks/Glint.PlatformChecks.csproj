<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Glint.Windows/GlobalUsings.cs" Link="GlobalUsings.cs" />
    <Compile Include="../Glint.Windows/Platform/*.cs" Link="Platform/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
